# ============================================================
# Настройки бэкенда «Грузчики»
# Скопируйте этот файл в .env и подставьте свои значения.
# ============================================================

# --- База данных ---
# SQLite (по умолчанию, для разработки):
DATABASE_URL=sqlite:///./gruzchiki.db
# PostgreSQL (для продакшена на Render + бесплатный Supabase/Neon):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- Безопасность: ОБЯЗАТЕЛЬНО замените в продакшене! ---
# --- Документация API ---
# true = открыть Swagger (/docs), ReDoc (/redoc) и OpenAPI-схему (/openapi.json).
# В продакшене держите false (по умолчанию) — схема API не должна быть публичной.
ENABLE_DOCS=false

JWT_SECRET=super-secret-key-change-me-1234567890
JWT_EXPIRE_MINUTES=10080

# --- Администратор по умолчанию ---
ADMIN_PHONE=+70000000000
ADMIN_PASSWORD=admin123
ADMIN_NAME=Администратор

# --- Бизнес-правила ---
MIN_TOPUP_AMOUNT=100
DEFAULT_COMMISSION=100
PHONE_VISIBLE_BALANCE=100
# Стоимость разблокировки телефонов заказчиков (разово)
PHONE_UNLOCK_AMOUNT=200
# Цена режима ТОП-20 за сутки
TOP20_DAILY_PRICE=200

# --- Реквизиты Совкомбанка (показываются грузчикам при пополнении) ---
BANK_NAME=Совкомбанк
BANK_PHONE=+7 923 236-36-62
BANK_CARD=2200 0000 0000 0000
BANK_HOLDER=Иванов Иван Иванович

# --- Telegram-бот (опционально). Пусто = бот выключен ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Имя бота без @ (например gruzchiki_bot) — для кнопки «Написать админу»
# в шапке сайта. Пусто = определяется автоматически через getMe при старте.
TELEGRAM_BOT_USERNAME=

# --- CORS: адреса фронтенда ---
# В продакшене фронтенд и API на одном домене, поэтому CORS не нужен.
# Оставьте локальные адреса для разработки.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
